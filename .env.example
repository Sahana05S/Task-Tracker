# ---------------------------------------------------------------------------
# TaskPulse — Environment Configuration Template
#
# Copy this file to `.env.local` and fill in the values from your Supabase
# project: Dashboard -> Project Settings -> API
#
#   cp .env.example .env.local     # macOS / Linux
#   Copy-Item .env.example .env.local   # Windows PowerShell
#
# `.env.local` holds real credentials and must never be committed.
# ---------------------------------------------------------------------------

# Base URL of your Supabase project.
# Example: https://abcdefghijklmnop.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Public anon key. Safe to expose to the browser: it carries no privileges of
# its own and every request it makes is still filtered by Row-Level Security.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# ---------------------------------------------------------------------------
# Do NOT add the service_role key here or anywhere reachable from the client.
# It bypasses Row-Level Security entirely. If a future server-only job needs
# it, load it from an unprefixed variable (no NEXT_PUBLIC_) and read it only
# inside server code.
# ---------------------------------------------------------------------------
